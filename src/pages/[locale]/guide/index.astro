---
import GuidePage from "../../../layouts/GuidePage.astro";
import { locales, type Locale } from "../../../i18n/content";

export function getStaticPaths() {
  return locales.filter((item) => item.code !== "en").map((item) => ({ params: { locale: item.code } }));
}

const locale = Astro.params.locale as Locale;
---

<GuidePage locale={locale} />
